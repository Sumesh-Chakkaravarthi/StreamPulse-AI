  },
  "paths": {
    "/api/v1/telemetry": {
      "post": {
        "summary": "Ingest Telemetry",
        "description": "High-Throughput Ingestion Gateway.\nExecutes Tier-1 physics guardrails, Isolation Forest, sequential drift autoencoder,\nand triggers Autonomous Diagnostic Agent upon anomaly detection.",
        "operationId": "ingest_telemetry_api_v1_telemetry_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelemetryPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnomalyDiagnostic"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
