  "components": {
    "schemas": {
      "AnomalyDiagnostic": {
        "properties": {
          "node_id": {
            "type": "string",
            "title": "Node Id"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "is_anomaly": {
            "type": "boolean",
            "title": "Is Anomaly"
          },
          "anomaly_score": {
            "type": "number",
            "title": "Anomaly Score",
            "description": "Anomaly confidence score 0.0 - 1.0"
          },
          "severity": {
            "type": "string",
            "title": "Severity",
            "description": "NOMINAL, WARNING, CRITICAL"
          },
          "primary_fault_feature": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Fault Feature"
          },
          "feature_contribution_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feature Contribution Pct"
          },
          "shap_contributions": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Shap Contributions"
          },
          "diagnostic_memo": {
            "type": "string",
            "title": "Diagnostic Memo"
          },
          "recommended_action": {
            "type": "string",
            "title": "Recommended Action"
          },
          "point_anomaly_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Point Anomaly Score"
          },
          "pinn_violation_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pinn Violation Score"
          },
          "sequence_drift_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sequence Drift Score"
          },
          "agent_report": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Report"
          }
        },
        "type": "object",
        "required": [
          "node_id",
          "timestamp",
          "is_anomaly",
          "anomaly_score",
          "severity",
          "diagnostic_memo",
          "recommended_action"
        ],
        "title": "AnomalyDiagnostic"
      },
      "EdgePartitionToggleRequest": {
        "properties": {
          "node_id": {
            "type": "string",
            "title": "Node Id"
          },
          "connected": {
            "type": "boolean",
            "title": "Connected",
            "description": "True to connect link, False to simulate network partition drop"
          }
        },
        "type": "object",
        "required": [
          "node_id",
          "connected"
        ],
        "title": "EdgePartitionToggleRequest"
      },
      "FaultInjectionRequest": {
        "properties": {
          "node_id": {
            "type": "string",
            "title": "Node Id"
          },
          "fault_type": {
            "type": "string",
            "title": "Fault Type",
            "description": "DRIFT, BIOFOULING, JUNCTION_POISON, FLATLINE_FAIL, CAVITATION_SPIKE"
          },
          "duration_seconds": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 5.0,
            "title": "Duration Seconds",
            "default": 60
          },
          "intensity": {
            "type": "number",
            "maximum": 5.0,
            "minimum": 0.1,
            "title": "Intensity",
            "default": 1.0
          }
        },
        "type": "object",
        "required": [
          "node_id",
          "fault_type"
        ],
        "title": "FaultInjectionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TelemetryBatch": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TelemetryPayload"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "TelemetryBatch"
      },
      "TelemetryPayload": {
        "properties": {
          "node_id": {
            "type": "string",
            "title": "Node Id",
            "description": "Industrial telemetry node identifier, e.g. NODE-WA-01"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp",
            "description": "UTC ISO 8601 timestamp"
          },
          "ph": {
            "type": "number",
            "maximum": 14.0,
            "minimum": 0.0,
            "title": "Ph",
            "description": "pH level (0-14)"
          },
          "temperature_c": {
            "type": "number",
            "maximum": 100.0,
            "minimum": -10.0,
            "title": "Temperature C",
            "description": "Process temperature in Celsius"
          },
          "turbidity_ntu": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Turbidity Ntu",
            "description": "Nephelometric Turbidity Units"
          },
          "flow_rate_lpm": {
            "type": "number",
            "maximum": 200.0,
            "minimum": 0.0,
            "title": "Flow Rate Lpm",
            "description": "Flow rate in Liters Per Minute"
          },
          "conductivity_us_cm": {
            "type": "number",
            "maximum": 5000.0,
            "minimum": 0.0,
            "title": "Conductivity Us Cm",
            "description": "Conductivity in microSiemens/cm"
          },
          "electrochemical_current_ua": {
            "type": "number",
            "title": "Electrochemical Current Ua",
            "description": "Potentiostat / Amperometric cell current in microAmps"
          },
          "applied_potential_v": {
            "type": "number",
            "title": "Applied Potential V",
            "description": "Applied electrode potential in Volts",
            "default": 0.45
          },
          "snr_db": {
            "type": "number",
            "title": "Snr Db",
            "description": "Signal-to-noise ratio in dB",
            "default": 45.0
          },
          "calibration_status": {
            "type": "string",
            "title": "Calibration Status",
            "description": "VALID, DRIFT_WARNING, or EXPIRED",
            "default": "VALID"
          },
          "firmware_version": {
            "type": "string",
            "title": "Firmware Version",
            "default": "v2.4.1-rc"
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata"
          },
          "edge_metrics": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Edge Metrics"
          }
        },
        "type": "object",
        "required": [
          "node_id",
          "ph",
          "temperature_c",
          "turbidity_ntu",
          "flow_rate_lpm",
          "conductivity_us_cm",
          "electrochemical_current_ua"
        ],
        "title": "TelemetryPayload"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}